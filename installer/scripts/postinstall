#!/bin/bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Issen Software Group
# The driver ships inside the app and is loaded after login (never at boot).
# Remove a boot-time copy left by the withdrawn first 1.3.0 package; macOS drops it
# from the kernel collection on the next restart.
if [[ -d /Library/Extensions/RTL8723BEWiFi.kext ]]; then
    /bin/rm -rf /Library/Extensions/RTL8723BEWiFi.kext
    /usr/bin/logger -t rtl8723be-installer "removed /Library/Extensions/RTL8723BEWiFi.kext"
fi
/usr/bin/xattr -dr com.apple.quarantine "/Applications/RTL8723BE Wireless Utility.app" 2>/dev/null || true
exit 0
